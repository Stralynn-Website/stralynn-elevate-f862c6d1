# Server
PORT=5000
NODE_ENV=production

# MongoDB (Atlas connection string)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stralynn?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin bootstrap (used only by `npm run create-admin`)
ADMIN_EMAIL=admin@stralynn.com
ADMIN_PASSWORD=change_this_password

# CORS - comma separated list of allowed origins (your live frontend domain(s))
CORS_ORIGINS=https://stralynn.com,https://www.stralynn.com,http://localhost:3000

# Optional: shared secret the frontend can send as a header, extra layer against random bots
CONTACT_FORM_SECRET=

# Email (SMTP) — used to send confirmation emails for contact form
# submissions and job applications. Works with Gmail (use an App Password,
# not your normal password — see https://myaccount.google.com/apppasswords)
# or any SMTP provider (SendGrid, Mailgun, Postmark, etc).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tejashwnijaiswal@gmail.com
SMTP_PASS=your_gmail_app_password_here
MAIL_FROM="Stralynn <tejashwnijaiswal@gmail.com>"

# Internal address notified whenever someone submits the contact form or
# applies to a job. Defaults to connect@stralynn.com — override if needed.
COMPANY_NOTIFY_EMAIL=connect@stralynn.com
