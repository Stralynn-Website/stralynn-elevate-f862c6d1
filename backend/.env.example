# Server
PORT=5000
# NODE_ENV=production

# MongoDB (Atlas connection string)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stralynn?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin bootstrap (used only by `npm run create-admin`)
ADMIN_EMAIL=admin@stralynn.com
ADMIN_PASSWORD=change_this_password

# CORS - comma separated list of allowed origins (your live frontend domain(s))
CORS_ORIGINS=http://localhost:8080,http://localhost:5000

# Optional: shared secret the frontend can send as a header, extra layer against random bots
# CONTACT_FORM_SECRET=
